{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cheby",
      "camelcase": "Cheby",
      "title": "Cheby",
      "scope": "source.cheby",
      "file-types": [
        "cheby"
      ],
      "injection-regex": "^cheby$",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "Cheby grammar for tree-sitter",
    "authors": [
      {
        "name": "xikxp1",
        "email": "xikxp1@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/cheby-lang/tree-sitter-cheby"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
